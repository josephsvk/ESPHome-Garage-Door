# =========================================================
# SPOLOCNE WIFI
# =========================================================

wifi_ssid: "TEST_WIFI"
wifi_password: "CHANGE_ME_WIFI_PASSWORD"

fallback_password: "CHANGE_ME_FALLBACK_PASSWORD"


# =========================================================
# GARAGE 01 - IDENTITA
# =========================================================

garage01_node_name: "duko-esp32-s3-0001"
garage01_friendly_name: "Dusan Garage V1"

# Vlastny stabilny identifikator zariadenia.
garage01_device_id: "garage-001"

# Funkcia zariadenia.
garage01_device_role: "garage-door"

# Lokalita / skupina - nepovinne.
garage01_site_id: "dusan-garage"


# =========================================================
# GARAGE 01 - HARDWARE
# =========================================================

# ESPHome board ID pre bezne dosky s modulom ESP32-S3-WROOM-1.
# Podla konkretnej dosky moze byt potrebne upravit na presny variant.
garage01_board: "esp32-s3-devkitc-1"

# Framework.
garage01_framework: "esp-idf"

# Hardverova revizia tvojej zostavy.
garage01_hw_revision: "1.0"


# =========================================================
# GARAGE 01 - SIET
# =========================================================

garage01_wg_address: "10.84.0.3"

garage01_wg_endpoint: "CHANGE_ME_WIREGUARD_ENDPOINT"

garage01_wg_port: 51822

# ESPHome API encryption key musi byt 32 bajtov v base64.
garage01_api_key: "CHANGE_ME_32_BYTE_BASE64_API_KEY"

garage01_ota_password: "CHANGE_ME_OTA_PASSWORD"

garage01_wg_private_key: "CHANGE_ME_WIREGUARD_PRIVATE_KEY"

garage01_wg_public_key: "CHANGE_ME_VPS_WIREGUARD_PUBLIC_KEY"
