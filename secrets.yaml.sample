# =========================================================
# DEVICE
# =========================================================

node_name: "dusan-garage-door-01"
friendly_name: "Dusan Garage Door"

device_id: "dusan-garage-door-01"
device_role: "garage-door"
site_id: "dusan-garage"

board: "esp32dev"
framework: "esp-idf"
hw_revision: "1.0"

# GPIO piny su zavisle od konkretnej dosky a zapojenia.
#
# Tento priklad zodpoveda tvojmu aktualnemu zapojeniu:
# - OPEN rele: GPIO19
# - CLOSE rele: GPIO18
# - STOP rele: GPIO23
# - senzor uplne zatvorenych dveri: GPIO21
# - DHT22: GPIO15
#
# Poznamky k doskam:
# - ESP32 classic / esp32dev: tato pin mapa je vhodna pre bezne dev dosky.
# - ESP32-S3: GPIO23 nie je pouzitelny a GPIO19 moze kolidovat s USB-Serial-JTAG;
#   pre S3 pouzi napriklad OPEN=GPIO4, CLOSE=GPIO5, STOP=GPIO6, CLOSED=GPIO7, DHT22=GPIO15.
# - ESP32-C3/C6/C2: pinout je iny, preto treba tieto hodnoty urcit podla konkretnej dosky.
# - Vyhni sa flash/USB/boot strap pinom, ak nevies presne, ako sa spravaju pri boote.
gpio_open: GPIO19
gpio_close: GPIO18
gpio_stop: GPIO23
gpio_closed: GPIO21
gpio_dht22: GPIO15


# =========================================================
# WIFI
# =========================================================

wifi_ssid: "TEST_WIFI"
wifi_password: "CHANGE_ME_WIFI_PASSWORD"
fallback_password: "CHANGE_ME_FALLBACK_PASSWORD"


# =========================================================
# ESPHOME
# =========================================================

api_key: "CHANGE_ME_32_BYTE_BASE64_API_KEY"
ota_password: "CHANGE_ME_OTA_PASSWORD"


# =========================================================
# WIREGUARD
# =========================================================

wg_address: "10.84.0.3"
wg_private_key: "CHANGE_ME_DEVICE_PRIVATE_KEY"

wg_peer_public_key: "CHANGE_ME_SERVER_PUBLIC_KEY"
wg_endpoint: "vpn.example.com"
wg_endpoint_port: 51822

wg_allowed_ips: "10.0.0.0/8"
